{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redacted OmniRoute capability battery validation receipt v2.0",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "manifest_sha256",
    "validated_at",
    "planned_slot_count",
    "evidence_count"
  ],
  "properties": {
    "schema_version": { "enum": ["2.0", "1.0"] },
    "status": { "const": "valid" },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "planned_slot_count": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
