{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redacted OmniRoute capability battery manifest v2.0",
  "type": "object",
  "required": [
    "schema_version",
    "battery_id",
    "catalog_snapshot_id",
    "controls",
    "planned_slots",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "enum": ["2.0", "1.0"]
    },
    "battery_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,160}$"
    },
    "catalog_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\r\n]+$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\r\n]+$"
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\r\n]+$"
    },
    "harness": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]{1,100}$"
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\r\n]+$"
    },
    "gateway_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\r\n]+$"
    },
    "stop_rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\r\n]+$"
    },
    "cost_tracking": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\r\n]+$"
    },
    "final_classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\r\n]+$"
    },
    "controls": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "integer" },
          { "type": "boolean" },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\r\n]+$"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]{1,160}$"
      }
    },
    "planned_slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slot" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["slot_id", "capability", "rubric_version", "input_sha256"],
      "properties": {
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\r\n]+$"
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\r\n]+$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requested_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._/:@-]{1,160}$"
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\r\n]+$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["slot_id", "attempt", "status", "requested_model"],
      "properties": {
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "pass",
            "semantic_fail",
            "transport_fail",
            "protocol_fail",
            "not_run",
            "inconclusive"
          ]
        },
        "requested_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._/:@-]{1,160}$"
        },
        "effective_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\r\n]+$"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "artifact_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\r\n]+$"
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_verdict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\r\n]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\r\n]+$"
        },
        "attempt_timestamp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\r\n]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
