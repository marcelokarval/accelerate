{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets/schemas/development-heartbeat-v1.schema.json",
  "title": "Development heartbeat v1 (observation and reconciliation only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "heartbeat_id", "graph_id", "observed_at", "expires_at", "previous_sequence", "sequence", "observed_graph_state", "graph_baseline", "observed_repository_snapshot", "triggers", "reanalysis", "subject", "authority"],
  "properties": {
    "contract_version": {"const": "development-heartbeat/v1"}, "heartbeat_id": {"$ref": "#/$defs/id"}, "graph_id": {"$ref": "#/$defs/id"},
    "observed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "previous_sequence": {"type": "integer", "minimum": 0}, "sequence": {"type": "integer", "minimum": 1},
    "observed_graph_state": {"enum": ["DRAFT", "FROZEN_CURRENT", "STALE_REANALYSIS_REQUIRED", "SUPERSEDED", "BLOCKED", "CANCELLED"]},
    "graph_baseline": {"$ref": "#/$defs/baseline"}, "observed_repository_snapshot": {"$ref": "#/$defs/git_snapshot"}, "triggers": {"type": "array", "items": {"$ref": "#/$defs/trigger"}},
    "reanalysis": {"type": "object", "additionalProperties": false, "required": ["status", "trigger_ids"], "properties": {"status": {"enum": ["not-required", "required"]}, "trigger_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["node_id", "assignment_id", "agent_id", "call_id", "actor_epoch", "candidate_sha256", "observed_fence_token", "dispatch_receipt"], "properties": {"node_id": {"$ref": "#/$defs/id"}, "assignment_id": {"$ref": "#/$defs/id"}, "agent_id": {"$ref": "#/$defs/id"}, "call_id": {"$ref": "#/$defs/id"}, "actor_epoch": {"type": "integer", "minimum": 0}, "candidate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "observed_fence_token": {"$ref": "#/$defs/id"}, "dispatch_receipt": {"type": "object", "additionalProperties": false, "required": ["locator", "sha256"], "properties": {"locator": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["kind", "may_authorize", "may_lease", "may_approve", "may_close"], "properties": {"kind": {"const": "observation-reconciliation"}, "may_authorize": {"const": false}, "may_lease": {"const": false}, "may_approve": {"const": false}, "may_close": {"const": false}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["category", "git_snapshot"], "properties": {"category": {"const": "delta-baseline"}, "git_snapshot": {"$ref": "#/$defs/git_snapshot"}}},
    "repo_path": {"type": "string", "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f])(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)[^/]+(?:/[^/]+)*$"},
    "git_snapshot": {"type": "object", "additionalProperties": false, "required": ["head", "parents", "branch_mode", "branch", "upstream", "upstream_divergence", "staged_fingerprint", "unstaged_fingerprint", "untracked_fingerprint", "staged_paths", "unstaged_paths", "untracked_paths", "operation_state"], "properties": {"head": {"$ref": "#/$defs/sha256"}, "parents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "branch_mode": {"enum": ["branch", "detached"]}, "branch": {"type": ["string", "null"], "minLength": 1}, "upstream": {"type": ["string", "null"], "minLength": 1}, "upstream_divergence": {"type": "object", "additionalProperties": false, "required": ["ahead", "behind"], "properties": {"ahead": {"type": "integer", "minimum": 0}, "behind": {"type": "integer", "minimum": 0}}}, "staged_fingerprint": {"$ref": "#/$defs/sha256"}, "unstaged_fingerprint": {"$ref": "#/$defs/sha256"}, "untracked_fingerprint": {"$ref": "#/$defs/sha256"}, "staged_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}}, "unstaged_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}}, "untracked_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}}, "operation_state": {"type": "object", "additionalProperties": false, "required": ["kind", "conflict_paths"], "properties": {"kind": {"enum": ["none", "merge", "rebase", "cherry-pick", "revert"]}, "conflict_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}}}}}, "allOf": [{"if": {"properties": {"branch_mode": {"const": "branch"}}}, "then": {"properties": {"branch": {"type": "string", "minLength": 1}}}}, {"if": {"properties": {"branch_mode": {"const": "detached"}}}, "then": {"properties": {"branch": {"type": "null"}}}}]},
    "trigger": {"type": "object", "additionalProperties": false, "required": ["trigger_id", "kind", "evidence"], "properties": {"trigger_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["git-change", "contract-spec-scope-change", "runtime-capability-change", "lease-fence-change", "review-evidence-change"]}, "evidence": {"type": "string", "minLength": 1}}}
  }
}
