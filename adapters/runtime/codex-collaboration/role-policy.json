{
  "schema_version": 1,
  "runtime": "codex-collaboration",
  "policy_status": "experimental",
  "authority_boundary": "subordinate-to-accelerate",
  "binding": {
    "spawn_api": "collaboration.spawn_agent",
    "model_override": "explicit-per-assignment",
    "reasoning_effort_override": "explicit-per-assignment",
    "tool_enforcement": "assignment-contract-only",
    "skill_visibility": "on-demand-contract-only",
    "mcp_visibility": "on-demand-contract-only",
    "logical_topology": "adapters/runtime/codex/logical-agent-topology.toml"
  },
  "routes": {
    "direct-fast-path": {
      "delegation_budget": 0,
      "physical_binding_allowed": false
    },
    "scoped": {
      "delegation_budget": 1,
      "physical_binding_allowed": true
    },
    "orchestrated": {
      "delegation_budget": "2-3",
      "physical_binding_allowed": true
    }
  },
  "session_lifecycle": {
    "reuse_relevant_agent_context": true,
    "duplicate_active_lane": "forbidden",
    "interrupt_semantics": "stop-not-rollback",
    "interrupted_writer_reconciliation": "root-required-before-replacement-or-next-writer"
  },
  "profiles": {
    "explorer": {
      "model": "gpt-5.6-luna",
      "reasoning_effort": "low",
      "tool_policy": [
        "read-source",
        "search-local"
      ],
      "skill_allowlist": [],
      "mcp_allowlist": [],
      "write_mode": "read-only",
      "requires_write_scope": false,
      "requires_reasoning_receipt": false,
      "return_contract": "Agent Return Packet",
      "return_fields": [
        "paths_and_lines",
        "answer",
        "gaps",
        "self_review",
        "self_forensic_review",
        "residual_risks",
        "root_closure_boundary"
      ],
      "eligibility": [
        "bounded local discovery with no implementation or global design judgment"
      ]
    },
    "librarian": {
      "model": "gpt-5.6-luna",
      "reasoning_effort": "low",
      "tool_policy": [
        "search-official-docs",
        "read-source"
      ],
      "skill_allowlist": [
        "openai-docs"
      ],
      "mcp_allowlist": [
        "context7"
      ],
      "write_mode": "read-only",
      "requires_write_scope": false,
      "requires_reasoning_receipt": false,
      "return_contract": "Agent Return Packet",
      "return_fields": [
        "sources",
        "source_version",
        "official_vs_community",
        "conclusion",
        "uncertainty",
        "self_review",
        "self_forensic_review",
        "residual_risks",
        "root_closure_boundary"
      ],
      "eligibility": [
        "bounded current documentation or source research with a citation return"
      ]
    },
    "architecture-review": {
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium",
